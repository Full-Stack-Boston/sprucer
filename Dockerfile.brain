FROM python:3.12-slim

WORKDIR /app
RUN useradd -m -u 1000 sprucer
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY fixtures ./fixtures
COPY scripts/docker-entrypoint-brain.sh /entrypoint.sh
RUN pip install --no-cache-dir . \
  && mkdir -p /data \
  && chown -R sprucer:sprucer /app /data \
  && chmod +x /entrypoint.sh

ENV SPRUCER_HOST=0.0.0.0
ENV SPRUCER_PORT=8787
ENV SPRUCER_DATABASE_URL=sqlite:////data/sprucer.db
# Containers listen on all interfaces; compose sets ALLOW_INSECURE_DEV for local-dev auth.
ENV SPRUCER_ALLOW_INSECURE_DEV=1

EXPOSE 8787
# Start as root only long enough to chown the mounted /data volume, then drop to sprucer.
USER root
ENTRYPOINT ["/entrypoint.sh"]
CMD ["sprucer-brain"]
